{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/sdx/hooks/preflight.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "timeout 10 bash \"${CLAUDE_PLUGIN_ROOT}\"/sdx/hooks/selftest.sh; exit 0"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/sdx/hooks/prod-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/sdx/hooks/stop-gate.sh"
          }
        ]
      }
    ]
  }
}
