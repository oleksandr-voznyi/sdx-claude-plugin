#!/usr/bin/env bash
# Per-project verify command template for stop-gate (REQ-GATE-2).
#
# HOW TO ACTIVATE:
#   cp .claude/sdx/verify-cmd.sh.template .claude/sdx/verify-cmd.sh
#   # then EDIT the copy for your stack — see the warning below
#
# The file's PRESENCE activates it (DEBT-026, amendment to ADR-4, 2026-09-01).
# The execute bit does not decide WHETHER it runs — only HOW: executable, and stop-gate
# execs it directly so this shebang applies (write the runner in any language you like);
# not executable, and stop-gate interprets it as bash.
# This template itself is never picked up — it is excluded by its NAME
# (verify-cmd.sh.template), not by its mode.
#
# WARNING: copy and configure in one go. The moment .claude/sdx/verify-cmd.sh
# exists, it IS the test floor — an unedited copy still carries the PHP example
# below and will fail in any project that is not PHP.
#
# To opt out, delete the file. Stop-gate then falls back to autodetect
# (composer/npm/phpunit); if that finds nothing too, it exits 0 (no-op) —
# the safe default for projects without a test suite.
#
# Tip: use --fast for a quick unit-only subset under stop-gate; save the full
# suite for CI. stop-gate is most effective when the run is < ~30 seconds.
set -uo pipefail

case "${1:-}" in
  --fast)
    # Quick unit-only subset (PHP example):
    exec ./vendor/bin/phpunit --testsuite=unit
    # Node example: exec npm run test:unit
    ;;
  *)
    # Full suite:
    exec ./vendor/bin/phpunit
    # Node example: exec npm test
    ;;
esac
